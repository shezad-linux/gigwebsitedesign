# ==============================================================================
# Supabase Configuration for AI Gig-Matching Platform
#
# Quick Setup:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy the Project URL and Project API anon/public key below
# 4. Copy this file to `.env.local`: `cp .env.example .env.local`
# 5. In Supabase Dashboard -> SQL Editor, run `supabase/schema.sql`, `supabase/seed.sql`, and `supabase/admin_rbac.sql`
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Project Public/Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
# Used exclusively for server-enforced RBAC verifications, migrations, and background operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# ==============================================================================
# Spring Boot Monolith Configuration (Optional Fallback)
# If running the Spring Boot backend in `server/`, default is port 8080.
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
